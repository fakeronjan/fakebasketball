{
  "name": "fake-basketball",
  "productName": "Fake Basketball",
  "version": "1.0.0",
  "description": "Fake Basketball desktop build (Electron wrapper around the web port)",
  "author": "fakeronjan",
  "private": true,
  "main": "main.js",
  "scripts": {
    "build-app": "node build-app.mjs",
    "start": "node build-app.mjs && electron .",
    "dist:win": "node build-app.mjs && electron-builder --win dir --x64"
  },
  "devDependencies": {
    "@fontsource/cascadia-mono": "5.3.0",
    "electron": "44.9.2",
    "electron-builder": "26.18.0",
    "pyodide": "0.27.0",
    "xterm": "5.3.0",
    "xterm-addon-fit": "0.8.0"
  },
  "build": {
    "appId": "com.fakeronjan.fakebasketball",
    "productName": "Fake Basketball",
    "copyright": "fakeronjan",
    "directories": {
      "buildResources": "assets",
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "app/**/*",
      "assets/icon-256.png"
    ],
    "asar": true,
    "win": {
      "target": "dir",
      "icon": "assets/icon.ico",
      "signAndEditExecutable": true
    },
    "mac": {
      "target": "dir",
      "icon": "assets/icon.png"
    }
  }
}
